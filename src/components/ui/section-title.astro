---
interface Props {
    title: string;
    subtitle?: string;
    badge?: string;
    align?: 'left' | 'center' | 'right';
}

const { title, subtitle, badge, align = 'center' } = Astro.props;

const alignClasses = {
    'left': 'text-left',
    'center': 'text-center mx-auto',
    'right': 'text-right ml-auto'
};
---

<div class={`max-w-4xl mb-16 ${alignClasses[align]}`}>
    {badge && (
        <span class="inline-block bg-primary/10 text-primary text-xs font-bold px-4 py-1.5 rounded-full mb-6 uppercase tracking-wider">
            {badge}
        </span>
    )}
    <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4 tracking-tight">
        {title}
    </h1>
    {subtitle && (
        <p class="text-gray-500 text-lg md:text-xl">
            {subtitle}
        </p>
    )}
</div>
