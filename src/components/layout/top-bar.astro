---
import Phone from '~icons/lucide/phone'
import WhatsApp from '~icons/fa-brands/whatsapp'
import Mail from '~icons/lucide/mail'
import Facebook from '~icons/fa-brands/facebook'
import Instagram from '~icons/fa-brands/instagram'
import type { NavItem } from '@/types/rush'
import { CONTACT } from '@/constants/contact'

interface Props {
    items?: NavItem[]
}

const { items = [] } = Astro.props
---

<div class="bg-[#f8f8f8] text-[#333333] text-xs py-3 md:py-2 border-b border-gray-100 block">
    <div class="container mx-auto px-4 flex justify-between items-center">
        <div class="flex items-center w-full md:w-auto justify-between md:justify-start md:gap-6">
            <div class="flex items-center gap-6 md:gap-6">
                 <a href={CONTACT.phone.link} class="flex items-center gap-1 hover:text-[#00692d] transition-colors p-2 border border-gray-300 rounded-lg md:border-0 md:p-0" aria-label="Telefone">
                    <Phone width="20" height="20" class="md:w-4 md:h-4" />
                    <span class="hidden md:inline">{ CONTACT.phone.display}</span>
                </a>
                <a href={CONTACT.whatsapp.link} class="flex items-center gap-1 hover:text-[#00692d] transition-colors p-2 border border-gray-300 rounded-lg md:border-0 md:p-0" aria-label="WhatsApp">
                    <WhatsApp width="20" height="20" class="md:w-4 md:h-4" />
                    <span class="hidden md:inline">{CONTACT.whatsapp.display}</span>
                </a>
                <a href={`mailto:${CONTACT.email.general}`} class="flex items-center gap-1 hover:text-[#00692d] transition-colors p-2 border border-gray-300 rounded-lg md:border-0 md:p-0" aria-label="Email">
                    <Mail width="20" height="20" class="md:w-4 md:h-4" />
                    <span class="hidden md:inline">{CONTACT.email.general}</span>
                </a>
            </div>

            <div class="h-4 w-px bg-gray-300 mx-2 hidden md:block" />

            <div class="flex items-center gap-6 md:gap-3">
                <a href={CONTACT.social.facebook} target="_blank" rel="noopener noreferrer" class="hover:text-[#00692d] transition-colors p-2 border border-gray-300 rounded-lg md:border-0 md:p-0" aria-label="Facebook">
                     <Facebook width="20" height="20" class="md:w-4 md:h-4" />
                </a>
                <a href={CONTACT.social.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-[#00692d] transition-colors p-2 border border-gray-300 rounded-lg md:border-0 md:p-0" aria-label="Instagram">
                    <Instagram width="20" height="20" class="md:w-4 md:h-4" />
                </a>
            </div>
        </div>

        <div class="hidden md:flex items-center gap-6 font-semibold">
            {items.map((item) => (
                item.children && item.children.length > 0 ? (
                    <div class="relative group">
                        <button 
                            class="hover:text-[#00692d] transition-colors uppercase flex items-center gap-1"
                            aria-haspopup="true"
                            aria-expanded="false"
                        >
                            {item.title}
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </button>
                        <div class="absolute left-0 top-full pt-2 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-200 z-50">
                            <div class="bg-white shadow-lg rounded-lg py-2 min-w-[200px] border border-gray-100">
                                {item.children.map((child) => (
                                    <a 
                                        href={child.url} 
                                        target={child.target}
                                        rel={child.target === '_blank' ? 'noopener noreferrer' : undefined}
                                        class="block px-4 py-2 hover:bg-gray-50 hover:text-[#00692d] transition-colors"
                                    >
                                        {child.title}
                                    </a>
                                ))}
                            </div>
                        </div>
                    </div>
                ) : (
                    <a 
                        href={item.url} 
                        target={item.target}
                        rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
                        class="hover:text-[#00692d] transition-colors uppercase"
                    >
                        {item.title}
                    </a>
                )
            ))}
        </div>
    </div>
</div>
