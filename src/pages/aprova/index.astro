---
import Layout from '@/layouts/layout.astro'
import SectionTitle from '@/components/ui/section-title.astro'
import AprovaCard from '@/components/aprova-card.astro'
import { rush } from "@/lib/rush"
import type { CmsEntry } from '@/types/rush'

let items: CmsEntry[] = []

try {
    const response = await rush.getEntries('aprova', { limit: 1000 })
    items = (response as { data?: CmsEntry[] }).data || []
} catch (e) {
    console.error('Failed to fetch aprova entries:', e)
}
---

<Layout title="Nossos alunos Aprova" description="Cada aprovação é resultado de dedicação, esforço e muito apoio da nossa equipe.">
    <div class="container mx-auto px-4 py-16 md:py-24">
        <SectionTitle 
            title="Nossos alunos Aprova" 
            subtitle="Cada aprovação é resultado de dedicação, esforço e muito apoio da nossa equipe." 
            badge="Orgulho Imperatrice" 
        />

        {items.length === 0 ? (
            <div class="text-center py-20 bg-gray-50 rounded-xl border-dashed border-2 border-gray-200">
                <p class="text-gray-500 text-lg">Nenhuma aprovação encontrada no momento.</p>
            </div>
        ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {items.map((item: any) => (
                    <AprovaCard item={item} />
                ))}
            </div>
        )}
    </div>
</Layout>
