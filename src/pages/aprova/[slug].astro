---
import Layout from "@/layouts/layout.astro";
import { rush } from "@/lib/rush";
import type { CmsEntry } from "@/types/rush";
import { renderRichText } from "@/utils/rich-text";
import IconMapPin from "~icons/lucide/map-pin";
import IconArrowLeft from "~icons/lucide/arrow-left";
import IconWhatsapp from "~icons/fa-brands/whatsapp";

export async function getStaticPaths() {
    try {
        const response = await rush.getEntries("aprova", { limit: 1000 });
        const items = (response as { data?: CmsEntry[] }).data || [];

        return items.map((item) => ({
            params: { slug: item.slug },
            props: { item },
        }));
    } catch (e) {
        console.error("Failed to fetch aprova entries:", e);
        return [];
    }
}

const { item } = Astro.props as { item: CmsEntry };

// Extract firstName to check gender or just use general term
const isFemale = item.title.toLowerCase().endsWith("a"); // Simple heuristic or just use "SOBRE A APROVAÇÃO"
const pillText = "SOBRE A APROVAÇÃO";
---

<Layout
    title={`${item.title} - Aprovação ${item.data?.place}`}
    description={item.excerpt ||
        `Conheça a história de aprovação de ${item.title} no ${item.data?.place}.`}
>
    <div class="bg-white min-h-screen pt-16 md:pt-24">
        <div class="container mx-auto px-4 max-w-5xl">
            <div class="flex flex-col md:flex-row gap-12 md:gap-24 mb-24">
                {/* Left Column - Profile */}
                <div
                    class="w-full md:w-1/3 flex flex-col items-center text-center shrink-0"
                >
                    {
                        item.featured_image ? (
                            <div class="w-48 h-48 rounded-full overflow-hidden border-4 border-gray-100 mb-6 shadow-sm">
                                <img
                                    src={item.featured_image.url}
                                    alt={item.title}
                                    class="w-full h-full object-cover"
                                />
                            </div>
                        ) : (
                            <div class="w-48 h-48 rounded-full bg-gray-100 mb-6 flex items-center justify-center text-gray-400 border-4 border-gray-50 shadow-sm">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-20 w-20"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                                    />
                                </svg>
                            </div>
                        )
                    }

                    <div
                        class="bg-primary/10 text-primary text-xs font-black px-4 py-1.5 rounded-full mb-4 inline-flex items-center gap-1.5 uppercase tracking-wide"
                    >
                        <IconMapPin class="h-4 w-4" />
                        {item.data?.place}
                    </div>

                    <h2 class="text-xl font-bold text-primary mb-1">
                        {item.data?.course}
                    </h2>

                    <p class="text-gray-500 text-sm mb-8">
                        {item.data?.line}
                    </p>

                    <div class="flex flex-col gap-3 w-full max-w-xs mx-auto">
                        <a
                            href="/aprova"
                            class="w-full py-3 px-4 rounded-md border border-primary text-primary font-bold text-sm flex justify-center items-center gap-2 hover:bg-primary hover:text-white transition-colors"
                        >
                            <IconArrowLeft class="h-4 w-4" />
                            Voltar para Aprova
                        </a>
                        <a
                            href={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="w-full py-3 px-4 rounded-md bg-primary-dark text-white font-bold text-sm flex justify-center items-center gap-2 hover:bg-primary-darker transition-colors"
                        >
                            <IconWhatsapp class="h-4 w-4" />
                            Fale conosco
                        </a>
                    </div>
                </div>

                {/* Right Column - Content */}
                <div class="w-full md:w-2/3 flex flex-col justify-center">
                    <div class="mb-4">
                        <span
                            class="inline-block bg-primary/10 text-primary text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider"
                        >
                            {pillText}
                        </span>
                    </div>

                    <h1
                        class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-6 tracking-tight"
                    >
                        {item.title}
                    </h1>

                    <div
                        class="prose prose-lg text-gray-600 leading-relaxed max-w-none"
                    >
                        <Fragment
                            set:html={renderRichText(
                                item.data?.content || item.content,
                            )}
                        />
                    </div>
                </div>
            </div>
        </div>

        {/* CTA Section */}
        <div class="bg-primary-dark py-16 md:py-24 text-center px-4">
            <div class="max-w-3xl mx-auto">
                <h2
                    class="text-3xl md:text-4xl font-extrabold text-white mb-4 tracking-tight"
                >
                    Seu filho também pode ser aprovado!
                </h2>
                <p class="text-white/90 text-lg md:text-xl mb-8 font-medium">
                    Agende uma visita e conheça como o Colégio Imperatrice
                    prepara os alunos para as melhores universidades.
                </p>
                <a
                    href={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 bg-secondary hover:bg-secondary/90 text-gray-900 font-bold py-3 px-8 rounded-md transition-transform hover:-translate-y-1 shadow-lg"
                >
                    <IconWhatsapp class="h-[18px] w-[18px]" />
                    Agendar Visita
                </a>
            </div>
        </div>
    </div>
</Layout>
